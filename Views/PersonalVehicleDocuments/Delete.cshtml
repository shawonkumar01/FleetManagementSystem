@model PersonalVehicleDocument
@{
    ViewData["Title"] = "Delete Document";
}

<div class="panel" style="max-width:500px;">
    <div class="panel-header">
        <h5><i class="fas fa-trash-alt"></i> Delete Document</h5>
    </div>
    <div class="panel-body" style="text-align:center;">
        <div style="padding:20px;">
            <i class="fas fa-file-alt" style="font-size:3rem; color:#f87171; margin-bottom:20px;"></i>
            <h3 style="margin-bottom:10px;">Delete this document?</h3>
            <p style="color:#94a3b8; margin-bottom:20px;">
                <strong style="color:#e2e8f0;">@Model.Title</strong><br>
                Type: @Model.DocumentType<br>
                Vehicle: @Model.PersonalVehicle.Name
            </p>
            <p style="color:#f87171; font-size:0.9rem;">
                <i class="fas fa-exclamation-triangle"></i> This will permanently delete the file.
            </p>
        </div>

        <form asp-action="Delete" method="post" style="display:flex; gap:12px; justify-content:center;">
            <input type="hidden" asp-for="Id" />
            <button type="submit" class="btn-indigo" style="background:#dc2626;">
                <i class="fas fa-trash"></i> Yes, Delete
            </button>
            <a asp-controller="PersonalVehicles" asp-action="Details" asp-route-id="@Model.PersonalVehicleId" class="btn-ghost">Cancel</a>
        </form>
    </div>
</div>
