@model FleetManagementSystem.Models.Trip
@{
    ViewData["Title"] = "Delete Trip";
}

<div class="panel" style="max-width:500px;">
    <div class="panel-header">
        <h5 style="color:#f87171;"><i class="fas fa-trash"></i> Delete Trip</h5>
    </div>
    <div class="panel-body">
        <p style="color:#94a3b8; margin-bottom:20px;">
            Are you sure you want to delete this trip? This action cannot be undone.
        </p>

        <div class="detail-item" style="margin-bottom:12px;">
            <span class="detail-label">Route</span>
            <span class="detail-value">@Model.Origin → @Model.Destination</span>
        </div>
        <div class="detail-item" style="margin-bottom:12px;">
            <span class="detail-label">Vehicle</span>
            <span class="detail-value">@Model.Vehicle.Make @Model.Vehicle.Model</span>
        </div>
        <div class="detail-item" style="margin-bottom:12px;">
            <span class="detail-label">Driver</span>
            <span class="detail-value">@Model.Driver.FirstName @Model.Driver.LastName</span>
        </div>
        <div class="detail-item" style="margin-bottom:20px;">
            <span class="detail-label">Status</span>
            <span class="badge @(Model.Status == "Completed" ? "badge-completed" : Model.Status == "Planned" ? "badge-planned" : "badge-inactive")">
                @Model.Status
            </span>
        </div>

        <form asp-action="Delete">
            <input type="hidden" asp-for="Id" />
            <div style="display:flex; gap:10px;">
                <button type="submit" class="btn-indigo" style="background:#dc2626;">
                    <i class="fas fa-trash"></i> Yes, Delete
                </button>
                <a asp-action="Index" class="btn-ghost">Cancel</a>
            </div>
        </form>
    </div>
</div>