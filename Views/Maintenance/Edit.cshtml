@model FleetManagementSystem.Models.Maintenance
@{
    ViewData["Title"] = "Edit Maintenance Record";
}

<div class="panel" style="max-width:600px;">
    <div class="panel-header">
        <h5><i class="fas fa-pen"></i> Edit — @Model.ServiceType</h5>
        <a asp-action="Index" class="btn-ghost"><i class="fas fa-arrow-left"></i> Back</a>
    </div>
    <div class="panel-body">
        <form asp-action="Edit">
            <input type="hidden" asp-for="Id" />
            <div asp-validation-summary="ModelOnly" class="text-danger" style="margin-bottom:12px;"></div>

            <div class="form-group">
                <label asp-for="VehicleId" class="form-label">Vehicle</label>
                <select asp-for="VehicleId" asp-items="ViewBag.Vehicles" class="form-input"></select>
                <span asp-validation-for="VehicleId" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="ServiceType" class="form-label">Service Type</label>
                <input asp-for="ServiceType" class="form-input" />
                <span asp-validation-for="ServiceType" class="text-danger"></span>
            </div>

            <div class="grid-2">
                <div class="form-group">
                    <label asp-for="ServiceDate" class="form-label">Service Date</label>
                    <input asp-for="ServiceDate" class="form-input" type="date" />
                    <span asp-validation-for="ServiceDate" class="text-danger"></span>
                </div>
                <div class="form-group">
                    <label asp-for="NextServiceDate" class="form-label">Next Service Date (optional)</label>
                    <input asp-for="NextServiceDate" class="form-input" type="date" />
                    <span asp-validation-for="NextServiceDate" class="text-danger"></span>
                </div>
            </div>

            <div class="form-group">
                <label asp-for="Cost" class="form-label">Cost (৳)</label>
                <input asp-for="Cost" class="form-input" type="number" step="0.01" />
                <span asp-validation-for="Cost" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="Status" class="form-label">Status</label>
                <select asp-for="Status" class="form-input">
                    <option value="Scheduled">Scheduled</option>
                    <option value="Completed">Completed</option>
                    <option value="Overdue">Overdue</option>
                </select>
                <span asp-validation-for="Status" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="Notes" class="form-label">Notes (optional)</label>
                <textarea asp-for="Notes" class="form-input" rows="3"></textarea>
                <span asp-validation-for="Notes" class="text-danger"></span>
            </div>

            <div style="display:flex; gap:10px; margin-top:20px;">
                <button type="submit" class="btn-indigo">
                    <i class="fas fa-save"></i> Update Record
                </button>
                <a asp-action="Index" class="btn-ghost">Cancel</a>
            </div>
        </form>
    </div>
</div>