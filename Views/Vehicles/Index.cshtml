@model IEnumerable<FleetManagementSystem.Models.Vehicle>
@{
    ViewData["Title"] = "Vehicles";
}

@if (TempData["Success"] != null)
{
    <div class="alert-success-bar">
        <i class="fas fa-check-circle"></i> @TempData["Success"]
    </div>
}

<div class="panel">
    <div class="panel-header">
        <h5><i class="fas fa-car"></i> All Vehicles</h5>
        <a asp-action="Create" class="btn-indigo">
            <i class="fas fa-plus"></i> Add Vehicle
        </a>
    </div>
    <div class="panel-body" style="padding:0;">
        <table class="fleet-table">
            <thead>
                <tr>
                    <th>Make / Model</th>
                    <th>Year</th>
                    <th>License Plate</th>
                    <th>Mileage</th>
                    <th>Status</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var v in Model)
                {
                    <tr>
                        <td><strong>@v.Make</strong> @v.Model</td>
                        <td>@v.Year</td>
                        <td><code style="color:#818cf8;">@v.LicensePlate</code></td>
                        <td>@v.Mileage.ToString("N0") km</td>
                        <td>
                            <span class="badge @GetBadge(v.Status)">@v.Status</span>
                        </td>
                        <td>
                            <a asp-action="Details" asp-route-id="@v.Id" class="btn-ghost" style="font-size:0.8rem;">
                                <i class="fas fa-eye"></i>
                            </a>
                            <a asp-action="Edit" asp-route-id="@v.Id" class="btn-ghost" style="font-size:0.8rem;">
                                <i class="fas fa-pen"></i>
                            </a>
                            <a asp-action="Delete" asp-route-id="@v.Id" class="btn-ghost" style="font-size:0.8rem; color:#f87171;">
                                <i class="fas fa-trash"></i>
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@functions {
    string GetBadge(string status) => status switch
    {
        "Active" => "badge-active",
        "InMaintenance" => "badge-maintenance",
        "Retired" => "badge-inactive",
        _ => "badge-inactive"
    };
}