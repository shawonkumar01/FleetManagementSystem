@model FleetManagementSystem.Models.Vehicle
@{
    ViewData["Title"] = "Delete Vehicle";
}

<div class="panel" style="max-width:500px;">
    <div class="panel-header">
        <h5 style="color:#f87171;"><i class="fas fa-trash"></i> Delete Vehicle</h5>
    </div>
    <div class="panel-body">
        <p style="color:#94a3b8; margin-bottom:20px;">
            Are you sure you want to delete this vehicle? This action cannot be undone.
        </p>

        <div class="detail-item" style="margin-bottom:12px;">
            <span class="detail-label">Vehicle</span>
            <span class="detail-value">@Model.Make @Model.Model (@Model.Year)</span>
        </div>
        <div class="detail-item" style="margin-bottom:20px;">
            <span class="detail-label">License Plate</span>
            <span class="detail-value" style="color:#818cf8;">@Model.LicensePlate</span>
        </div>

        <form asp-action="Delete">
            <input type="hidden" asp-for="Id" />
            <div style="display:flex; gap:10px;">
                <button type="submit" class="btn-indigo" style="background:#dc2626;">
                    <i class="fas fa-trash"></i> Yes, Delete
                </button>
                <a asp-action="Index" class="btn-ghost">Cancel</a>
            </div>
        </form>
    </div>
</div>