@model IEnumerable<VehicleAssignment>
@{
    ViewData["Title"] = "Vehicle Assignments";
}

<div class="panel">
    <div class="panel-header">
        <h5><i class="fas fa-link"></i> Vehicle Assignments</h5>
        <a asp-action="Create" class="btn-indigo">
            <i class="fas fa-plus"></i> Assign Vehicle
        </a>
    </div>
    <div class="panel-body" style="padding:0;">
        <table class="fleet-table">
            <thead>
                <tr>
                    <th>Vehicle</th>
                    <th>Assigned Driver</th>
                    <th>Assigned Date</th>
                    <th>End Date</th>
                    <th>Status</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>@item.Vehicle.Make @item.Vehicle.Model (@item.Vehicle.LicensePlate)</td>
                        <td>@item.Driver.FirstName @item.Driver.LastName</td>
                        <td>@item.AssignedDate.ToString("MMM dd, yyyy")</td>
                        <td>@(item.EndDate?.ToString("MMM dd, yyyy") ?? "-")</td>
                        <td>
                            <span class="badge @(item.Status == "Active" ? "badge-active" : "badge-inactive")">
                                @item.Status
                            </span>
                        </td>
                        <td>
                            <a asp-action="Details" asp-route-id="@item.Id" class="btn-ghost" style="padding:4px 10px; font-size:0.8rem;">
                                <i class="fas fa-eye"></i>
                            </a>
                            @if (item.Status == "Active")
                            {
                                <a asp-action="EndAssignment" asp-route-id="@item.Id" class="btn-ghost" style="padding:4px 10px; font-size:0.8rem; color:#f87171;"
                                   onclick="return confirm('End this assignment?');">
                                    <i class="fas fa-stop"></i> End
                                </a>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
