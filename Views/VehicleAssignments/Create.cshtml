@model VehicleAssignment
@{
    ViewData["Title"] = "Assign Vehicle";
}

<div class="panel" style="max-width:600px;">
    <div class="panel-header">
        <h5><i class="fas fa-plus"></i> Assign Vehicle to Driver</h5>
    </div>
    <div class="panel-body">
        <form asp-action="Create" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger" style="margin-bottom:16px;"></div>

            <div class="form-group">
                <label class="form-label">Vehicle</label>
                <select asp-for="VehicleId" class="form-input" asp-items="ViewBag.Vehicles" required>
                    <option value="">Select Vehicle</option>
                </select>
            </div>

            <div class="form-group">
                <label class="form-label">Driver</label>
                <select asp-for="DriverId" class="form-input" asp-items="ViewBag.Drivers" required>
                    <option value="">Select Driver</option>
                </select>
            </div>

            <div class="form-group">
                <label class="form-label">Notes</label>
                <textarea asp-for="Notes" class="form-input" rows="3"></textarea>
            </div>

            <div style="display:flex; gap:12px; margin-top:24px;">
                <button type="submit" class="btn-indigo">
                    <i class="fas fa-link"></i> Assign Vehicle
                </button>
                <a asp-action="Index" class="btn-ghost">Cancel</a>
            </div>
        </form>
    </div>
</div>
