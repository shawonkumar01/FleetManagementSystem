@model IEnumerable<Document>
@{
    ViewData["Title"] = "Document Management";
}

<div class="panel">
    <div class="panel-header">
        <h5><i class="fas fa-file-alt"></i> Document Management</h5>
        <div style="display:flex; gap:12px;">
            <a asp-action="Expiring" class="btn-ghost" style="font-size:0.8rem;">
                <i class="fas fa-exclamation-triangle"></i> Expiring (@ViewBag.ExpiringSoon)
            </a>
            <a asp-action="Expired" class="btn-ghost" style="font-size:0.8rem; color:#f87171;">
                <i class="fas fa-times-circle"></i> Expired (@ViewBag.ExpiredDocuments)
            </a>
            <a asp-action="Create" class="btn-indigo">
                <i class="fas fa-upload"></i> Upload Document
            </a>
        </div>
    </div>

    <!-- Statistics -->
    <div class="grid-4" style="display:grid; grid-template-columns:repeat(auto-fit, minmax(200px, 1fr)); gap:16px; padding:24px; background:#1a1d35;">
        <div class="stat-card">
            <div class="stat-icon blue">
                <i class="fas fa-file-alt"></i>
            </div>
            <div class="stat-info">
                <h4>@ViewBag.TotalDocuments</h4>
                <p>Total Documents</p>
            </div>
        </div>
        <div class="stat-card">
            <div class="stat-icon green">
                <i class="fas fa-check-circle"></i>
            </div>
            <div class="stat-info">
                <h4>@ViewBag.ActiveDocuments</h4>
                <p>Active Documents</p>
            </div>
        </div>
        <div class="stat-card">
            <div class="stat-icon orange">
                <i class="fas fa-exclamation-triangle"></i>
            </div>
            <div class="stat-info">
                <h4>@ViewBag.ExpiringSoon</h4>
                <p>Expiring Soon</p>
            </div>
        </div>
        <div class="stat-card">
            <div class="stat-icon red">
                <i class="fas fa-times-circle"></i>
            </div>
            <div class="stat-info">
                <h4>@ViewBag.ExpiredDocuments</h4>
                <p>Expired</p>
            </div>
        </div>
    </div>

    <!-- Filters -->
    <div class="panel-body" style="background:#252842; margin-top:16px;">
        <form asp-action="Index" method="get" style="display:flex; gap:12px; flex-wrap:wrap; align-items:end;">
            <div class="form-group" style="flex:1; min-width:150px;">
                <label class="form-label">Search</label>
                <input type="text" name="search" value="@ViewBag.CurrentSearch" class="form-input" placeholder="Title, description, tags..." />
            </div>
            <div class="form-group" style="flex:1; min-width:150px;">
                <label class="form-label">Category</label>
                <select name="category" class="form-input">
                    <option value="">All Categories</option>
                    @foreach (var cat in ViewBag.Categories)
                    {
                        <option value="@cat" selected="@(ViewBag.CurrentCategory == cat)">@cat</option>
                    }
                </select>
            </div>
            <div class="form-group" style="flex:1; min-width:150px;">
                <label class="form-label">Vehicle</label>
                <select name="vehicleId" class="form-input">
                    <option value="">All Vehicles</option>
                    @foreach (var vehicle in ViewBag.Vehicles)
                    {
                        <option value="@vehicle.Id" selected="@(ViewBag.CurrentVehicleId == vehicle.Id)">@vehicle.Make @vehicle.Model</option>
                    }
                </select>
            </div>
            <div class="form-group" style="flex:1; min-width:150px;">
                <label class="form-label">Driver</label>
                <select name="driverId" class="form-input">
                    <option value="">All Drivers</option>
                    @foreach (var driver in ViewBag.Drivers)
                    {
                        <option value="@driver.Id" selected="@(ViewBag.CurrentDriverId == driver.Id)">@driver.FirstName @driver.LastName</option>
                    }
                </select>
            </div>
            <div class="form-group" style="flex:1; min-width:150px;">
                <label class="form-label">Status</label>
                <select name="status" class="form-input">
                    <option value="">All Status</option>
                    <option value="Active" selected="@(ViewBag.CurrentStatus == "Active")">Active</option>
                    <option value="Expired" selected="@(ViewBag.CurrentStatus == "Expired")">Expired</option>
                    <option value="Archived" selected="@(ViewBag.CurrentStatus == "Archived")">Archived</option>
                </select>
            </div>
            <div class="form-group">
                <button type="submit" class="btn-indigo">
                    <i class="fas fa-filter"></i> Filter
                </button>
            </div>
        </form>
    </div>

    <!-- Documents Table -->
    <div class="panel-body" style="padding:0;">
        <table class="fleet-table">
            <thead>
                <tr>
                    <th>Document</th>
                    <th>Category</th>
                    <th>Linked To</th>
                    <th>Upload Date</th>
                    <th>Expiry</th>
                    <th>Size</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="7" style="text-align:center; padding:40px; color:#94a3b8;">
                            <i class="fas fa-folder-open" style="font-size:3rem; margin-bottom:16px;"></i>
                            <p>No documents found. Upload your first document!</p>
                            <a asp-action="Create" class="btn-indigo">
                                <i class="fas fa-upload"></i> Upload Document
                            </a>
                        </td>
                    </tr>
                }
                else
                {
                    @foreach (var doc in Model)
                    {
                        <tr>
                            <td>
                                <div style="display:flex; align-items:center; gap:12px;">
                                    <i class="@GetFileIcon(doc.FileExtension)" style="font-size:1.5rem; color:@GetFileColor(doc.FileExtension);"></i>
                                    <div>
                                        <strong>@doc.Title</strong>
                                        @if (!string.IsNullOrEmpty(doc.Description))
                                        {
                                            <br />
                                            <small style="color:#94a3b8;">@TruncateString(doc.Description, 50)</small>
                                        }
                                        @if (doc.Version > 1)
                                        {
                                            <span class="badge badge-planned" style="font-size:0.7rem; margin-left:8px;">v@(doc.Version)</span>
                                        }
                                    </div>
                                </div>
                            </td>
                            <td>
                                <span class="badge badge-planned">@doc.Category</span>
                            </td>
                            <td>
                                @if (doc.Vehicle != null)
                                {
                                    <div>
                                        <i class="fas fa-car"></i> @doc.Vehicle.Make @doc.Vehicle.Model
                                    </div>
                                }
                                @if (doc.Driver != null)
                                {
                                    <div>
                                        <i class="fas fa-user"></i> @doc.Driver.FirstName @doc.Driver.LastName
                                    </div>
                                }
                            </td>
                            <td>
                                @doc.UploadedAt.ToString("MMM dd, yyyy")
                                <br />
                                <small style="color:#94a3b8;">by @doc.UploadedBy</small>
                            </td>
                            <td>
                                @if (doc.ExpiryDate.HasValue)
                                {
                                    var daysUntilExpiry = (doc.ExpiryDate.Value - DateTime.UtcNow).Days;
                                    var color = daysUntilExpiry < 0 ? "#f87171" : daysUntilExpiry <= 30 ? "#fbbf24" : "#22c55e";
                                    <div style="color:@color;">
                                        <i class="fas fa-clock"></i> @doc.ExpiryDate.Value.ToString("MMM dd, yyyy")
                                        @if (daysUntilExpiry < 0)
                                        {
                                            <span class="badge badge-completed" style="font-size:0.7rem; margin-left:8px;">Expired</span>
                                        }
                                        else if (daysUntilExpiry <= 30)
                                        {
                                            <span class="badge badge-planned" style="font-size:0.7rem; margin-left:8px;">@daysUntilExpiry days</span>
                                        }
                                    </div>
                                }
                                else
                                {
                                    <span style="color:#64748b;">-</span>
                                }
                            </td>
                            <td>
                                @FormatFileSize(doc.FileSize)
                            </td>
                            <td>
                                <div style="display:flex; gap:4px;">
                                    <a asp-action="View" asp-route-id="@doc.Id" target="_blank" class="btn-ghost" style="font-size:0.75rem; padding:6px 10px;" title="View">
                                        <i class="fas fa-eye"></i>
                                    </a>
                                    <a asp-action="Download" asp-route-id="@doc.Id" class="btn-ghost" style="font-size:0.75rem; padding:6px 10px;" title="Download">
                                        <i class="fas fa-download"></i>
                                    </a>
                                    <a asp-action="Edit" asp-route-id="@doc.Id" class="btn-ghost" style="font-size:0.75rem; padding:6px 10px;" title="Edit">
                                        <i class="fas fa-edit"></i>
                                    </a>
                                    <a asp-action="Details" asp-route-id="@doc.Id" class="btn-ghost" style="font-size:0.75rem; padding:6px 10px;" title="Details">
                                        <i class="fas fa-info-circle"></i>
                                    </a>
                                    <a asp-action="Delete" asp-route-id="@doc.Id" class="btn-ghost" style="font-size:0.75rem; padding:6px 10px; color:#f87171;" title="Archive">
                                        <i class="fas fa-archive"></i>
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>

<style>
    .grid-4 { display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 16px; }
</style>

@functions {
    string GetFileIcon(string? extension)
    {
        return extension?.ToLower() switch
        {
            ".pdf" => "fas fa-file-pdf",
            ".doc" or ".docx" => "fas fa-file-word",
            ".xls" or ".xlsx" => "fas fa-file-excel",
            ".jpg" or ".jpeg" or ".png" or ".gif" => "fas fa-file-image",
            ".zip" or ".rar" => "fas fa-file-archive",
            _ => "fas fa-file"
        };
    }

    string GetFileColor(string? extension)
    {
        return extension?.ToLower() switch
        {
            ".pdf" => "#f87171",
            ".doc" or ".docx" => "#60a5fa",
            ".xls" or ".xlsx" => "#22c55e",
            ".jpg" or ".jpeg" or ".png" or ".gif" => "#a78bfa",
            _ => "#94a3b8"
        };
    }

    string FormatFileSize(long bytes)
    {
        string[] sizes = { "B", "KB", "MB", "GB" };
        double len = bytes;
        int order = 0;
        while (len >= 1024 && order < sizes.Length - 1)
        {
            order++;
            len /= 1024;
        }
        return $"{len:0.##} {sizes[order]}";
    }

    string TruncateString(string? value, int maxLength)
    {
        if (string.IsNullOrEmpty(value)) return "";
        return value.Length <= maxLength ? value : value.Substring(0, maxLength) + "...";
    }
}
