@model IEnumerable<Alert>

@if (!Model.Any())
{
    <div style="padding:20px; text-align:center; color:#94a3b8;">
        <i class="fas fa-bell-slash" style="font-size:1.5rem; margin-bottom:8px;"></i>
        <p style="font-size:0.85rem; margin:0;">No new alerts</p>
    </div>
}
else
{
    <div style="max-height:300px; overflow-y:auto;">
        @foreach (var alert in Model)
        {
            <div style="
                padding:12px 16px;
                border-bottom:1px solid #2d3150;
                display:flex;
                align-items:flex-start;
                gap:10px;
                cursor:pointer;
                background:#252842;
                " onmouseenter="this.style.background='#1e2235'" onmouseleave="this.style.background='#252842'">
                
                <div style="
                    width:32px;
                    height:32px;
                    border-radius:6px;
                    display:flex;
                    align-items:center;
                    justify-content:center;
                    font-size:0.8rem;
                    background:@(alert.Type == "Danger" ? "#7f1d1d" : alert.Type == "Warning" ? "#713f12" : "#1e3a5f");
                    color:@(alert.Type == "Danger" ? "#f87171" : alert.Type == "Warning" ? "#fbbf24" : "#60a5fa");">
                    <i class="fas fa-@(alert.Category == "License" ? "id-card" : alert.Category == "Maintenance" ? "wrench" : "info-circle")"></i>
                </div>
                
                <div style="flex:1; min-width:0;">
                    <h6 style="margin:0; font-size:0.85rem; color:#e2e8f0; white-space:nowrap; overflow:hidden; text-overflow:ellipsis;">@alert.Title</h6>
                    <p style="margin:2px 0 0 0; font-size:0.75rem; color:#94a3b8; line-height:1.3;">@alert.Message</p>
                    <span style="font-size:0.7rem; color:#64748b;">@alert.CreatedAt.ToString("MMM dd")</span>
                </div>
            </div>
        }
    </div>
    <div style="padding:10px 16px; border-top:1px solid #2d3150; text-align:center;">
        <a href="/Alerts" style="font-size:0.8rem; color:#818cf8; text-decoration:none;">View All Alerts</a>
    </div>
}
