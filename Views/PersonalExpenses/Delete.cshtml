@model PersonalExpense
@{
    ViewData["Title"] = "Delete Expense";
    Layout = ViewData["Layout"]?.ToString() ?? "~/Views/Shared/_Layout.cshtml";
}

<div class="panel" style="max-width:500px;">
    <div class="panel-header">
        <h5><i class="fas fa-trash-alt"></i> Delete Expense</h5>
    </div>
    <div class="panel-body" style="text-align:center;">
        <div style="padding:20px;">
            <i class="fas fa-exclamation-triangle" style="font-size:3rem; color:#f87171; margin-bottom:20px;"></i>
            <h3 style="margin-bottom:10px;">Delete this expense?</h3>
            <p style="color:#94a3b8; margin-bottom:20px;">
                <strong style="color:#e2e8f0;">@Model.ExpenseType</strong> - @Model.Amount.ToString("C")<br>
                Date: @Model.ExpenseDate.ToString("MMM dd, yyyy")<br>
                Vehicle: @Model.PersonalVehicle.Name
            </p>
        </div>

        <form asp-action="Delete" method="post" style="display:flex; gap:12px; justify-content:center;">
            <input type="hidden" asp-for="Id" />
            <button type="submit" class="btn-indigo" style="background:#dc2626;">
                <i class="fas fa-trash"></i> Yes, Delete
            </button>
            <a asp-controller="PersonalVehicles" asp-action="Details" asp-route-id="@Model.PersonalVehicleId" class="btn-ghost">Cancel</a>
        </form>
    </div>
</div>
