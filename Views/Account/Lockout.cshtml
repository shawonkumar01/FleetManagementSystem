@{
    ViewData["Title"] = "Locked Out";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6 text-center">
            <div class="card shadow-sm">
                <div class="card-body p-5">
                    <h1 class="display-1 text-warning"><i class="fas fa-lock"></i></h1>
                    <h2 class="mb-4">Account Locked</h2>
                    <p class="text-muted mb-4">Your account has been temporarily locked due to too many failed login attempts. Please try again later.</p>
                    <a asp-controller="Account" asp-action="Login" class="btn btn-primary">
                        <i class="fas fa-arrow-left"></i> Back to Login
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>
