<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Fleet Management</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
</head>
<body>

    <div class="fleet-wrapper">

        <!-- SIDEBAR - Simplified for regular users -->
        <nav class="sidebar">
            <div class="sidebar-brand">
                <i class="fas fa-motorcycle"></i>
                <span>My Vehicles</span>
            </div>

            <ul class="sidebar-nav">
                <li>
                    <a asp-controller="PersonalVehicles" asp-action="Index"
                       class="@(ViewContext.RouteData.Values["controller"]?.ToString() == "PersonalVehicles" ? "active" : "")">
                        <i class="fas fa-motorcycle"></i> My Vehicles
                    </a>
                </li>
            </ul>

            <div class="sidebar-footer">
                <span><i class="fas fa-circle text-success"></i> Online</span>
                <br />
                <small style="color:#94a3b8;">Personal Tracking</small>
            </div>
        </nav>

        <!-- MAIN CONTENT -->
        <div class="main-content">
            <header class="top-bar">
                <div class="top-bar-left">
                    <h4 class="page-title">@ViewData["Title"]</h4>
                </div>
                <div class="top-bar-right">
                    <span><i class="fas fa-user-circle"></i> @User.Identity?.Name</span>
                    <a asp-action="Logout" asp-controller="Account" class="btn-ghost" style="margin-left:12px;">
                        <i class="fas fa-sign-out-alt"></i> Logout
                    </a>
                </div>
            </header>

            <main class="main-content-inner">
                @RenderBody()
            </main>
        </div>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="toast-success" style="position:fixed; top:20px; right:20px; z-index:9999;">
            <i class="fas fa-check-circle"></i> @TempData["Success"]
        </div>
    }

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
