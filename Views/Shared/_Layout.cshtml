<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Fleet Management</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
</head>
<body>

    <div class="fleet-wrapper">

        <!-- SIDEBAR -->
        <nav class="sidebar">
            <div class="sidebar-brand">
                <i class="fas fa-truck"></i>
                <span>FleetMS</span>
            </div>

            <ul class="sidebar-nav">
                <li>
                    <a asp-controller="Home" asp-action="Index"
                       class="@(ViewContext.RouteData.Values["controller"]?.ToString() == "Home" ? "active" : "")">
                        <i class="fas fa-gauge-high"></i> Dashboard
                    </a>
                </li>
                <li>
                    <a asp-controller="Vehicles" asp-action="Index"
                       class="@(ViewContext.RouteData.Values["controller"]?.ToString() == "Vehicles" ? "active" : "")">
                        <i class="fas fa-car"></i> Vehicles
                    </a>
                </li>
                <li>
                    <a asp-controller="Drivers" asp-action="Index"
                       class="@(ViewContext.RouteData.Values["controller"]?.ToString() == "Drivers" ? "active" : "")">
                        <i class="fas fa-id-card"></i> Drivers
                    </a>
                </li>
                <li>
                    <a asp-controller="Trips" asp-action="Index"
                       class="@(ViewContext.RouteData.Values["controller"]?.ToString() == "Trips" ? "active" : "")">
                        <i class="fas fa-route"></i> Trips
                    </a>
                </li>
                <li>
                    <a asp-controller="Maintenance" asp-action="Index"
                       class="@(ViewContext.RouteData.Values["controller"]?.ToString() == "Maintenance" ? "active" : "")">
                        <i class="fas fa-wrench"></i> Maintenance
                    </a>
                </li>
                <li>
                    <a asp-controller="Reports" asp-action="Index"
                       class="@(ViewContext.RouteData.Values["controller"]?.ToString() == "Reports" ? "active" : "")">
                        <i class="fas fa-chart-bar"></i> Reports
                    </a>
                </li>
                <li>
                    <a asp-controller="Fuel" asp-action="Index"
                       class="@(ViewContext.RouteData.Values["controller"]?.ToString() == "Fuel" ? "active" : "")">
                        <i class="fas fa-gas-pump"></i> Fuel Logs
                    </a>
                </li>
            </ul>

            <div class="sidebar-footer">
                <span id="signalr-status"><i class="fas fa-circle text-muted"></i> Connecting...</span>
                <br />
                <small><i class="fas fa-circle-dot text-success"></i> System Online</small>
            </div>
        </nav>

        <!-- MAIN CONTENT -->
        <div class="main-content">
            <header class="top-bar">
                <div class="top-bar-left">
                    <h4 class="page-title">@ViewData["Title"]</h4>
                </div>
                <div class="top-bar-right">
                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        <span class="me-3"><i class="fas fa-user-circle"></i> @User.Identity.Name</span>
                        <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
                            <button type="submit" class="btn btn-sm btn-outline-danger">
                                <i class="fas fa-sign-out-alt"></i> Logout
                            </button>
                        </form>
                    }
                    else
                    {
                        <a asp-controller="Account" asp-action="Login" class="btn btn-sm btn-outline-primary">
                            <i class="fas fa-sign-in-alt"></i> Login
                        </a>
                    }
                </div>
            </header>

            <div class="content-area">
                @RenderBody()
            </div>
        </div>

    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>