@model PersonalVehicle
@{
    ViewData["Title"] = Model.Name;
    Layout = ViewData["Layout"]?.ToString() ?? "~/Views/Shared/_Layout.cshtml";
    var currentMonth = DateTime.Now.ToString("MMMM yyyy");
}

<!-- Monthly Stats Cards -->
<div class="grid-4" style="display:grid; grid-template-columns:repeat(auto-fit, minmax(200px, 1fr)); gap:16px; margin-bottom:24px;">
    <div class="stat-card">
        <div class="stat-icon green">
            <i class="fas fa-money-bill-wave"></i>
        </div>
        <div class="stat-info">
            <h3>@ViewBag.MonthlyFuelCost.ToString("C0")</h3>
            <p>Fuel - @currentMonth</p>
        </div>
    </div>
    <div class="stat-card">
        <div class="stat-icon yellow">
            <i class="fas fa-wrench"></i>
        </div>
        <div class="stat-info">
            <h3>@ViewBag.MonthlyMaintenanceCost.ToString("C0")</h3>
            <p>Maintenance - @currentMonth</p>
        </div>
    </div>
    <div class="stat-card">
        <div class="stat-icon indigo">
            <i class="fas fa-chart-line"></i>
        </div>
        <div class="stat-info">
            <h3>@ViewBag.TotalSpent.ToString("C0")</h3>
            <p>Total Spent</p>
        </div>
    </div>
    <div class="stat-card">
        <div class="stat-icon red">
            <i class="fas fa-gas-pump"></i>
        </div>
        <div class="stat-info">
            <h3>@ViewBag.TotalFuelLiters.ToString("F1") L</h3>
            <p>Total Fuel</p>
        </div>
    </div>
</div>

<div class="grid-2" style="display:grid; grid-template-columns:1fr 1fr; gap:24px;">
    <!-- Vehicle Info -->
    <div class="panel">
        <div class="panel-header">
            <h5><i class="fas fa-info-circle"></i> Vehicle Details</h5>
            <a asp-action="Edit" asp-route-id="@Model.Id" class="btn-ghost" style="font-size:0.8rem;">
                <i class="fas fa-edit"></i> Edit
            </a>
        </div>
        <div class="panel-body">
            <div class="detail-item">
                <span class="detail-label">Name</span>
                <span class="detail-value">@Model.Name</span>
            </div>
            <div class="detail-item">
                <span class="detail-label">Make & Model</span>
                <span class="detail-value">@Model.Make @Model.Model @Model.Year</span>
            </div>
            <div class="detail-item">
                <span class="detail-label">License Plate</span>
                <span class="detail-value">@(Model.LicensePlate ?? "Not set")</span>
            </div>
            <div class="detail-item">
                <span class="detail-label">VIN</span>
                <span class="detail-value">@(Model.VIN ?? "Not set")</span>
            </div>
            <div class="detail-item">
                <span class="detail-label">Odometer</span>
                <span class="detail-value">@Model.CurrentOdometer.ToString("N0") km</span>
            </div>
            <div class="detail-item">
                <span class="detail-label">Purchase Date</span>
                <span class="detail-value">@Model.PurchaseDate.ToString("MMM dd, yyyy")</span>
            </div>
            <div class="detail-item">
                <span class="detail-label">Purchase Price</span>
                <span class="detail-value">@Model.PurchasePrice.ToString("C")</span>
            </div>
            @if (!string.IsNullOrEmpty(Model.Notes))
            {
                <div class="detail-item">
                    <span class="detail-label">Notes</span>
                    <span class="detail-value">@Model.Notes</span>
                </div>
            }
        </div>
    </div>

    <!-- Quick Actions -->
    <div class="panel">
        <div class="panel-header">
            <h5><i class="fas fa-bolt"></i> Quick Actions</h5>
        </div>
        <div class="panel-body" style="display:flex; flex-direction:column; gap:12px;">
            <a asp-controller="PersonalExpenses" asp-action="Create" asp-route-vehicleId="@Model.Id" asp-route-type="Fuel" class="btn-indigo" style="justify-content:flex-start;">
                <i class="fas fa-gas-pump"></i> Add Fuel Expense
            </a>
            <a asp-controller="PersonalExpenses" asp-action="Create" asp-route-vehicleId="@Model.Id" asp-route-type="Maintenance" class="btn-indigo" style="justify-content:flex-start; background:#4338ca;">
                <i class="fas fa-wrench"></i> Add Maintenance
            </a>
            <a asp-controller="PersonalVehicleDocuments" asp-action="Create" asp-route-vehicleId="@Model.Id" class="btn-indigo" style="justify-content:flex-start; background:#059669;">
                <i class="fas fa-file-upload"></i> Upload Document
            </a>
            <a asp-action="ExpenseReport" asp-route-id="@Model.Id" class="btn-ghost" style="justify-content:flex-start; margin-top:8px;">
                <i class="fas fa-chart-bar"></i> View Full Report
            </a>
        </div>
    </div>
</div>

<!-- Recent Expenses -->
<div class="panel" style="margin-top:24px;">
    <div class="panel-header">
        <h5><i class="fas fa-receipt"></i> Recent Expenses</h5>
        <a asp-controller="PersonalExpenses" asp-action="Index" asp-route-vehicleId="@Model.Id" class="btn-ghost" style="font-size:0.8rem;">
            View All
        </a>
    </div>
    <div class="panel-body" style="padding:0;">
        @if (Model.Expenses?.Any() != true)
        {
            <div style="padding:30px; text-align:center; color:#94a3b8;">
                <i class="fas fa-receipt" style="font-size:2rem; margin-bottom:10px;"></i>
                <p>No expenses recorded yet.</p>
            </div>
        }
        else
        {
            <table class="fleet-table">
                <thead>
                    <tr>
                        <th>Date</th>
                        <th>Type</th>
                        <th>Amount</th>
                        <th>Vendor</th>
                        <th>Notes</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var expense in Model.Expenses.Take(10))
                    {
                        <tr>
                            <td>@expense.ExpenseDate.ToString("MMM dd, yyyy")</td>
                            <td>
                                <span class="badge @(expense.ExpenseType == "Fuel" ? "badge-active" : expense.ExpenseType == "Maintenance" ? "badge-planned" : "badge-completed")">
                                    @expense.ExpenseType
                                </span>
                            </td>
                            <td style="color:#22c55e; font-weight:600;">@expense.Amount.ToString("C")</td>
                            <td>@(expense.Vendor ?? "-")</td>
                            <td style="font-size:0.85rem;">@(expense.Notes ?? "-")</td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </div>
</div>

<!-- Documents -->
<div class="panel" style="margin-top:24px;">
    <div class="panel-header">
        <h5><i class="fas fa-folder-open"></i> Documents</h5>
        <a asp-controller="PersonalVehicleDocuments" asp-action="Create" asp-route-vehicleId="@Model.Id" class="btn-ghost" style="font-size:0.8rem;">
            <i class="fas fa-plus"></i> Add Document
        </a>
    </div>
    <div class="panel-body">
        @if (Model.Documents?.Any() != true)
        {
            <div style="text-align:center; padding:30px; color:#94a3b8;">
                <i class="fas fa-folder" style="font-size:2rem; margin-bottom:10px;"></i>
                <p>No documents uploaded.</p>
            </div>
        }
        else
        {
            <div style="display:grid; grid-template-columns:repeat(auto-fill, minmax(200px, 1fr)); gap:16px;">
                @foreach (var doc in Model.Documents)
                {
                    <div style="background:#1a1d2e; border:1px solid #2d3150; border-radius:8px; padding:16px;">
                        <div style="display:flex; align-items:center; gap:10px; margin-bottom:10px;">
                            <i class="fas fa-file-alt" style="font-size:1.5rem; color:#818cf8;"></i>
                            <div>
                                <h6 style="margin:0; font-size:0.9rem; color:#e2e8f0;">@doc.Title</h6>
                                <small style="color:#64748b;">@doc.DocumentType</small>
                            </div>
                        </div>
                        @if (doc.ExpiryDate.HasValue)
                        {
                            var daysUntil = (doc.ExpiryDate.Value - DateTime.Now).Days;
                            <div style="font-size:0.8rem; margin-top:8px;">
                                <span class="badge @(daysUntil <= 30 ? "badge-overdue" : "badge-planned")">
                                    Expires: @doc.ExpiryDate.Value.ToString("MMM dd, yyyy")
                                </span>
                            </div>
                        }
                        <div style="display:flex; gap:8px; margin-top:12px;">
                            <a href="/uploads/@doc.FilePath" target="_blank" class="btn-ghost" style="padding:4px 10px; font-size:0.75rem;">
                                <i class="fas fa-eye"></i> View
                            </a>
                        </div>
                    </div>
                }
            </div>
        }
    </div>
</div>

<style>
    .grid-4 { display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 16px; }
    .grid-2 { display: grid; grid-template-columns: 1fr 1fr; gap: 24px; }
    @@media (max-width: 768px) {
        .grid-2 { grid-template-columns: 1fr; }
    }
</style>
