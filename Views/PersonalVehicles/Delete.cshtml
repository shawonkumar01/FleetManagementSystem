@model PersonalVehicle
@{
    ViewData["Title"] = "Delete Vehicle";
}

<div class="panel" style="max-width:500px;">
    <div class="panel-header">
        <h5><i class="fas fa-trash-alt"></i> Delete Vehicle</h5>
    </div>
    <div class="panel-body" style="text-align:center;">
        <div style="padding:20px;">
            <i class="fas fa-exclamation-triangle" style="font-size:3rem; color:#f87171; margin-bottom:20px;"></i>
            <h3 style="margin-bottom:10px;">Are you sure?</h3>
            <p style="color:#94a3b8; margin-bottom:20px;">
                You are about to delete <strong style="color:#e2e8f0;">@Model.Name</strong> (@Model.Make @Model.Model).<br>
                This will also delete all associated expenses and documents. This action cannot be undone.
            </p>
        </div>

        <form asp-action="Delete" method="post" style="display:flex; gap:12px; justify-content:center;">
            <input type="hidden" asp-for="Id" />
            <button type="submit" class="btn-indigo" style="background:#dc2626;">
                <i class="fas fa-trash"></i> Yes, Delete
            </button>
            <a asp-action="Index" class="btn-ghost">Cancel</a>
        </form>
    </div>
</div>
