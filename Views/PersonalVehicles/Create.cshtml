@model PersonalVehicle
@{
    ViewData["Title"] = "Add Vehicle";
    Layout = ViewData["Layout"]?.ToString() ?? "~/Views/Shared/_Layout.cshtml";
}

<div class="panel" style="max-width:600px;">
    <div class="panel-header">
        <h5><i class="fas fa-plus-circle"></i> Add Your Vehicle</h5>
    </div>
    <div class="panel-body">
        <form asp-action="Create" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger" style="margin-bottom:16px;"></div>

            <div class="form-group">
                <label class="form-label">Vehicle Name</label>
                <input asp-for="Name" class="form-input" placeholder="e.g., My Honda Bike" required />
                <span asp-validation-for="Name" class="text-danger"></span>
            </div>

            <div class="grid-2" style="display:grid; grid-template-columns:1fr 1fr; gap:16px;">
                <div class="form-group">
                    <label class="form-label">Make (Brand)</label>
                    <input asp-for="Make" class="form-input" placeholder="e.g., Honda" required />
                </div>
                <div class="form-group">
                    <label class="form-label">Model</label>
                    <input asp-for="Model" class="form-input" placeholder="e.g., CBR 150R" required />
                </div>
            </div>

            <div class="grid-3" style="display:grid; grid-template-columns:repeat(3, 1fr); gap:16px;">
                <div class="form-group">
                    <label class="form-label">Year</label>
                    <input asp-for="Year" class="form-input" type="number" min="1900" max="2100" value="2020" required />
                </div>
                <div class="form-group">
                    <label class="form-label">License Plate</label>
                    <input asp-for="LicensePlate" class="form-input" placeholder="e.g., DHK-1234" />
                </div>
                <div class="form-group">
                    <label class="form-label">Current Odometer</label>
                    <input asp-for="CurrentOdometer" class="form-input" type="number" min="0" placeholder="km" />
                </div>
            </div>

            <div class="form-group">
                <label class="form-label">VIN (Optional)</label>
                <input asp-for="VIN" class="form-input" placeholder="Vehicle Identification Number" maxlength="17" />
            </div>

            <div class="grid-2" style="display:grid; grid-template-columns:1fr 1fr; gap:16px;">
                <div class="form-group">
                    <label class="form-label">Purchase Date</label>
                    <input asp-for="PurchaseDate" class="form-input" type="date" value="@DateTime.Now.ToString("yyyy-MM-dd")" />
                </div>
                <div class="form-group">
                    <label class="form-label">Purchase Price</label>
                    <input asp-for="PurchasePrice" class="form-input" type="number" step="0.01" min="0" placeholder="0.00" />
                </div>
            </div>

            <div class="form-group">
                <label class="form-label">Notes</label>
                <textarea asp-for="Notes" class="form-input" rows="3" placeholder="Any additional information about your vehicle..."></textarea>
            </div>

            <div style="display:flex; gap:12px; margin-top:24px;">
                <button type="submit" class="btn-indigo">
                    <i class="fas fa-save"></i> Save Vehicle
                </button>
                <a asp-action="Index" class="btn-ghost">Cancel</a>
            </div>
        </form>
    </div>
</div>

<style>
    .grid-2 { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; }
    .grid-3 { display: grid; grid-template-columns: repeat(3, 1fr); gap: 16px; }
    @@media (max-width: 640px) {
        .grid-2, .grid-3 { grid-template-columns: 1fr; }
    }
</style>
