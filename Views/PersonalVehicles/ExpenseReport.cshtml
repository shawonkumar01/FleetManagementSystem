@model IEnumerable<PersonalExpense>
@{
    ViewData["Title"] = "Expense Report - " + ViewBag.Vehicle.Name;
    Layout = ViewData["Layout"]?.ToString() ?? "~/Views/Shared/_Layout.cshtml";
    var vehicle = ViewBag.Vehicle as PersonalVehicle;
    var monthlyData = ViewBag.MonthlyData;
}

<!-- Summary Cards -->
<div class="panel" style="margin-bottom:24px;">
    <div class="panel-header">
        <h5><i class="fas fa-chart-pie"></i> Cost Summary - @vehicle.Name</h5>
        <a asp-action="Details" asp-route-id="@vehicle.Id" class="btn-ghost" style="font-size:0.8rem;">
            <i class="fas fa-arrow-left"></i> Back to Vehicle
        </a>
    </div>
    <div class="panel-body">
        <div class="grid-4" style="display:grid; grid-template-columns:repeat(auto-fit, minmax(150px, 1fr)); gap:16px;">
            <div style="background:#252842; padding:16px; border-radius:8px; text-align:center;">
                <small style="color:#64748b; display:block; margin-bottom:4px;">Total Spent</small>
                <strong style="color:#e2e8f0; font-size:1.5rem;">@(((decimal)ViewBag.TotalSpent).ToString("C0"))</strong>
            </div>
            <div style="background:#252842; padding:16px; border-radius:8px; text-align:center;">
                <small style="color:#64748b; display:block; margin-bottom:4px;">Fuel Cost</small>
                <strong style="color:#22c55e; font-size:1.5rem;">@(((decimal)ViewBag.TotalFuel).ToString("C0"))</strong>
            </div>
            <div style="background:#252842; padding:16px; border-radius:8px; text-align:center;">
                <small style="color:#64748b; display:block; margin-bottom:4px;">Maintenance</small>
                <strong style="color:#fbbf24; font-size:1.5rem;">@(((decimal)ViewBag.TotalMaintenance).ToString("C0"))</strong>
            </div>
            <div style="background:#252842; padding:16px; border-radius:8px; text-align:center;">
                <small style="color:#64748b; display:block; margin-bottom:4px;">Total Fuel</small>
                <strong style="color:#818cf8; font-size:1.5rem;">@(((double)ViewBag.TotalLiters).ToString("F1")) L</strong>
            </div>
        </div>
    </div>
</div>

<!-- Monthly Breakdown -->
<div class="panel" style="margin-bottom:24px;">
    <div class="panel-header">
        <h5><i class="fas fa-calendar-alt"></i> Monthly Breakdown</h5>
    </div>
    <div class="panel-body" style="padding:0;">
        <table class="fleet-table">
            <thead>
                <tr>
                    <th>Month</th>
                    <th style="text-align:right;">Total</th>
                    <th style="text-align:right;">Fuel</th>
                    <th style="text-align:right;">Maintenance</th>
                    <th style="text-align:right;">Other</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var month in monthlyData)
                {
                    <tr>
                        <td><strong>@month.MonthName</strong></td>
                        <td style="text-align:right; color:#e2e8f0; font-weight:600;">@month.Total.ToString("C0")</td>
                        <td style="text-align:right; color:#22c55e;">@month.Fuel.ToString("C0")</td>
                        <td style="text-align:right; color:#fbbf24;">@month.Maintenance.ToString("C0")</td>
                        <td style="text-align:right; color:#818cf8;">@month.Other.ToString("C0")</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<!-- All Expenses -->
<div class="panel">
    <div class="panel-header">
        <h5><i class="fas fa-list-alt"></i> All Expenses</h5>
        <a asp-controller="PersonalExpenses" asp-action="Create" asp-route-vehicleId="@vehicle.Id" class="btn-indigo" style="font-size:0.8rem;">
            <i class="fas fa-plus"></i> Add Expense
        </a>
    </div>
    <div class="panel-body" style="padding:0;">
        @if (!Model.Any())
        {
            <div style="padding:40px; text-align:center; color:#94a3b8;">
                <i class="fas fa-receipt" style="font-size:3rem; margin-bottom:16px;"></i>
                <p>No expenses recorded yet.</p>
                <a asp-controller="PersonalExpenses" asp-action="Create" asp-route-vehicleId="@vehicle.Id" class="btn-indigo" style="margin-top:16px;">
                    Add First Expense
                </a>
            </div>
        }
        else
        {
            <table class="fleet-table">
                <thead>
                    <tr>
                        <th>Date</th>
                        <th>Type</th>
                        <th>Amount</th>
                        <th>Vendor</th>
                        <th>Odometer</th>
                        <th>Notes</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var expense in Model.OrderByDescending(e => e.ExpenseDate))
                    {
                        <tr>
                            <td>@expense.ExpenseDate.ToString("MMM dd, yyyy")</td>
                            <td>
                                <span class="badge @(expense.ExpenseType == "Fuel" ? "badge-active" : expense.ExpenseType == "Maintenance" ? "badge-planned" : "badge-completed")">
                                    @expense.ExpenseType
                                </span>
                            </td>
                            <td style="color:#22c55e; font-weight:600;">@expense.Amount.ToString("C")</td>
                            <td>@(expense.Vendor ?? "-")</td>
                            <td>@(expense.OdometerReading?.ToString("N0") ?? "-")</td>
                            <td style="font-size:0.85rem;">@(expense.Notes ?? "-")</td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </div>
</div>

<style>
    .grid-4 { display: grid; grid-template-columns: repeat(auto-fit, minmax(150px, 1fr)); gap: 16px; }
</style>
