@{
    ViewData["Title"] = "Dashboard";
}

<!-- Stat Cards -->
<div class="grid-4" style="margin-bottom:24px;">

    <div class="stat-card">
        <div class="stat-icon indigo">
            <i class="fas fa-car"></i>
        </div>
        <div class="stat-info">
            <h3>@ViewBag.TotalVehicles</h3>
            <p>Total Vehicles</p>
            <small style="color:#818cf8;">@ViewBag.ActiveVehicles Active</small>
        </div>
    </div>

    <div class="stat-card">
        <div class="stat-icon green">
            <i class="fas fa-id-card"></i>
        </div>
        <div class="stat-info">
            <h3>@ViewBag.TotalDrivers</h3>
            <p>Total Drivers</p>
            <small style="color:#22c55e;">@ViewBag.ActiveDrivers Active</small>
        </div>
    </div>

    <div class="stat-card">
        <div class="stat-icon yellow">
            <i class="fas fa-route"></i>
        </div>
        <div class="stat-info">
            <h3>@ViewBag.TotalTrips</h3>
            <p>Total Trips</p>
            <small style="color:#fbbf24;">@ViewBag.OngoingTrips In Progress</small>
        </div>
    </div>

    <div class="stat-card">
        <div class="stat-icon red">
            <i class="fas fa-wrench"></i>
        </div>
        <div class="stat-info">
            <h3>@ViewBag.PendingMaint</h3>
            <p>Maintenance</p>
            <small style="color:#f87171;">Scheduled</small>
        </div>
    </div>

</div>
<!-- Fuel Stats Row -->
<div class="grid-2" style="margin-bottom:24px;">
    <div class="stat-card">
        <div class="stat-icon green">
            <i class="fas fa-gas-pump"></i>
        </div>
        <div class="stat-info">
            <h3>৳@string.Format("{0:N0}", ViewBag.TotalFuelCost)</h3>
            <p>Total Fuel Cost</p>
            <small style="color:#22c55e;">All Vehicles</small>
        </div>
    </div>
    <div class="stat-card">
        <div class="stat-icon indigo">
            <i class="fas fa-droplet"></i>
        </div>
        <div class="stat-info">
            <h3>@string.Format("{0:N0}", ViewBag.TotalFuelLiters) L</h3>
            <p>Total Fuel Used</p>
            <small style="color:#818cf8;">All Vehicles</small>
        </div>
    </div>
</div>


<!-- Charts Row -->
<div class="grid-2" style="margin-bottom:24px;">
    <div class="panel">
        <div class="panel-header">
            <h5><i class="fas fa-chart-line"></i> Fuel Consumption Trend</h5>
        </div>
        <div class="panel-body">
            <canvas id="fuelChart" height="200"></canvas>
        </div>
    </div>
    <div class="panel">
        <div class="panel-header">
            <h5><i class="fas fa-chart-pie"></i> Trip Status Distribution</h5>
        </div>
        <div class="panel-body">
            <canvas id="tripChart" height="200"></canvas>
        </div>
    </div>
</div>

<!-- Cost Analysis Chart -->
<div class="panel" style="margin-bottom:24px;">
    <div class="panel-header">
        <h5><i class="fas fa-chart-bar"></i> Monthly Cost Analysis (Fuel vs Maintenance)</h5>
    </div>
    <div class="panel-body">
        <canvas id="costChart" height="100"></canvas>
    </div>
</div>

<!-- Recent Trips + Maintenance -->
<div class="grid-2">

    <!-- Recent Trips -->
    <div class="panel">
        <div class="panel-header">
            <h5><i class="fas fa-route"></i> Recent Trips</h5>
            <a asp-controller="Trips" asp-action="Index" class="btn-ghost" style="font-size:0.8rem;">
                View All
            </a>
        </div>
        <div class="panel-body" style="padding:0;">
            <table class="fleet-table">
                <thead>
                    <tr>
                        <th>Vehicle</th>
                        <th>Driver</th>
                        <th>Route</th>
                        <th>Status</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var t in ViewBag.RecentTrips)
                    {
                        <tr>
                            <td>@t.Vehicle.Make @t.Vehicle.Model</td>
                            <td>@t.Driver.FirstName</td>
                            <td style="font-size:0.82rem; color:#94a3b8;">
                                @t.Origin → @t.Destination
                            </td>
                            <td>
                                <span class="badge @(t.Status == "Completed" ? "badge-completed" : t.Status == "InProgress" ? "badge-active" : "badge-planned")">
                                    @t.Status
                                </span>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <!-- Recent Maintenance -->
    <div class="panel">
        <div class="panel-header">
            <h5><i class="fas fa-wrench"></i> Recent Maintenance</h5>
            <a asp-controller="Maintenance" asp-action="Index" class="btn-ghost" style="font-size:0.8rem;">
                View All
            </a>
        </div>
        <div class="panel-body" style="padding:0;">
            <table class="fleet-table">
                <thead>
                    <tr>
                        <th>Vehicle</th>
                        <th>Service</th>
                        <th>Cost</th>
                        <th>Status</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var m in ViewBag.RecentMaintenance)
                    {
                        <tr>
                            <td>@m.Vehicle.Make @m.Vehicle.Model</td>
                            <td style="font-size:0.82rem;">@m.ServiceType</td>
                            <td style="color:#22c55e;">৳@m.Cost.ToString("N0")</td>
                            <td>
                                <span class="badge @(m.Status == "Completed" ? "badge-completed" : m.Status == "Scheduled" ? "badge-planned" : "badge-overdue")">
                                    @m.Status
                                </span>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        // Fuel Consumption Chart
        const fuelCtx = document.getElementById('fuelChart').getContext('2d');
        new Chart(fuelCtx, {
            type: 'line',
            data: {
                labels: @Html.Raw(Json.Serialize(ViewBag.FuelChartLabels)),
                datasets: [{
                    label: 'Fuel (Liters)',
                    data: @Html.Raw(Json.Serialize(ViewBag.FuelChartData)),
                    borderColor: '#667eea',
                    backgroundColor: 'rgba(102, 126, 234, 0.1)',
                    tension: 0.4,
                    fill: true
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: { legend: { display: false } },
                scales: {
                    y: { beginAtZero: true, grid: { color: 'rgba(0,0,0,0.05)' } },
                    x: { grid: { display: false } }
                }
            }
        });

        // Trip Status Chart
        const tripCtx = document.getElementById('tripChart').getContext('2d');
        new Chart(tripCtx, {
            type: 'doughnut',
            data: {
                labels: ['Completed', 'In Progress', 'Planned', 'Cancelled'],
                datasets: [{
                    data: @Html.Raw(Json.Serialize(ViewBag.TripStatusData)),
                    backgroundColor: ['#22c55e', '#3b82f6', '#fbbf24', '#ef4444']
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: {
                    legend: { position: 'bottom', labels: { usePointStyle: true, padding: 15 } }
                }
            }
        });

        // Cost Analysis Chart
        const costCtx = document.getElementById('costChart').getContext('2d');
        new Chart(costCtx, {
            type: 'bar',
            data: {
                labels: @Html.Raw(Json.Serialize(ViewBag.CostChartLabels)),
                datasets: [
                    {
                        label: 'Fuel Cost',
                        data: @Html.Raw(Json.Serialize(ViewBag.FuelCostData)),
                        backgroundColor: '#667eea'
                    },
                    {
                        label: 'Maintenance Cost',
                        data: @Html.Raw(Json.Serialize(ViewBag.MaintenanceCostData)),
                        backgroundColor: '#f87171'
                    }
                ]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: { legend: { position: 'top' } },
                scales: {
                    y: { beginAtZero: true, grid: { color: 'rgba(0,0,0,0.05)' } },
                    x: { grid: { display: false } }
                }
            }
        });
    </script>
}