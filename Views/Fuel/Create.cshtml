@model FleetManagementSystem.Models.FuelRecord
@{
    ViewData["Title"] = "Add Fuel Record";
}

<div class="panel" style="max-width:600px;">
    <div class="panel-header">
        <h5><i class="fas fa-plus"></i> Add Fuel Record</h5>
        <a asp-action="Index" class="btn-ghost"><i class="fas fa-arrow-left"></i> Back</a>
    </div>
    <div class="panel-body">
        <form asp-action="Create">
            <div asp-validation-summary="ModelOnly" class="text-danger" style="margin-bottom:12px;"></div>

            <div class="form-group">
                <label asp-for="VehicleId" class="form-label">Vehicle</label>
                <select asp-for="VehicleId" asp-items="ViewBag.Vehicles" class="form-input">
                    <option value="">-- Select Vehicle --</option>
                </select>
                <span asp-validation-for="VehicleId" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="FuelDate" class="form-label">Fuel Date</label>
                <input asp-for="FuelDate" class="form-input" type="date" />
                <span asp-validation-for="FuelDate" class="text-danger"></span>
            </div>

            <div class="grid-2">
                <div class="form-group">
                    <label asp-for="LitersFilled" class="form-label">Liters Filled</label>
                    <input asp-for="LitersFilled" class="form-input" type="number" step="0.1" placeholder="e.g. 45.5" />
                    <span asp-validation-for="LitersFilled" class="text-danger"></span>
                </div>
                <div class="form-group">
                    <label asp-for="PricePerLiter" class="form-label">Price Per Liter (৳)</label>
                    <input asp-for="PricePerLiter" class="form-input" type="number" step="0.01" placeholder="e.g. 107" />
                    <span asp-validation-for="PricePerLiter" class="text-danger"></span>
                </div>
            </div>

            <div class="form-group">
                <label asp-for="TotalCost" class="form-label">Total Cost (৳) <small style="color:#64748b;">— leave 0 to auto-calculate</small></label>
                <input asp-for="TotalCost" class="form-input" type="number" step="0.01" placeholder="Auto-calculated if left 0" />
                <span asp-validation-for="TotalCost" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="OdometerReading" class="form-label">Odometer Reading (km)</label>
                <input asp-for="OdometerReading" class="form-input" type="number" placeholder="e.g. 32000" />
                <span asp-validation-for="OdometerReading" class="text-danger"></span>
            </div>

            <div class="grid-2">
                <div class="form-group">
                    <label asp-for="FilledBy" class="form-label">Filled By</label>
                    <input asp-for="FilledBy" class="form-input" placeholder="e.g. Rahim Uddin" />
                    <span asp-validation-for="FilledBy" class="text-danger"></span>
                </div>
                <div class="form-group">
                    <label asp-for="StationName" class="form-label">Station Name</label>
                    <input asp-for="StationName" class="form-input" placeholder="e.g. Padma Filling Station" />
                    <span asp-validation-for="StationName" class="text-danger"></span>
                </div>
            </div>

            <div class="form-group">
                <label asp-for="Notes" class="form-label">Notes (optional)</label>
                <textarea asp-for="Notes" class="form-input" rows="3" placeholder="Any additional notes..."></textarea>
                <span asp-validation-for="Notes" class="text-danger"></span>
            </div>

            <div style="display:flex; gap:10px; margin-top:20px;">
                <button type="submit" class="btn-indigo">
                    <i class="fas fa-save"></i> Save Record
                </button>
                <a asp-action="Index" class="btn-ghost">Cancel</a>
            </div>
        </form>
    </div>
</div>